# 后端环境变量模板
# 用法：复制为 .env（已在 .gitignore，不会提交），填入真实值后按 docs/CONFIG_SECRETS.md 的方式加载
# 切勿把真实值写回本文件或任何 yaml

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_admin_v3
DB_USERNAME=
DB_PASSWORD=
DRUID_USERNAME=druid
DRUID_PASSWORD=

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 邮件 =====
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== 对象存储（腾讯云 COS） =====
FILE_STORAGE_MODE=cloud
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
COS_BUCKET=letmedoit-1308200923
COS_DOMAIN=https://letmedoit-1308200923.cos.ap-guangzhou.myqcloud.com/

# ===== 微信小程序 =====
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=

# ===== 接口文档 Basic 认证（可选） =====
KNIFE4J_USERNAME=
KNIFE4J_PASSWORD=
