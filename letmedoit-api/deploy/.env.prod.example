# ============================================================
# 生产环境变量（放在服务器上，不要提交到仓库）
# 用法：cp .env.prod.example .env  →  填值  →  chmod 600 .env
# deploy.sh 通过 docker run --env-file .env 注入容器
#
# 格式约束（docker --env-file 的规则，别踩坑）：
#   - 一行一个 KEY=VALUE，等号两边不要空格
#   - 不要加引号，不要写 export，不要用 ${} 引用其他变量
#   - 值里的 # 只有出现在行首才是注释；密码含 # 时直接写（但建议换成别的字符）
#   - 空值写 KEY=（合法，表示空字符串）
#   - 必须使用 LF 换行，Windows 的 CRLF 会让值末尾带 \r
# ============================================================

# ===== 数据库（必填）=====
DB_HOST=
DB_PORT=3306
DB_NAME=letmedoit
DB_USERNAME=
DB_PASSWORD=
DRUID_USERNAME=druid
DRUID_PASSWORD=

# ===== Redis（必填）=====
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 邮件（找回密码 / 通知）=====
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== 对象存储（生产默认 cloud 模式，缺密钥会上传失败）=====
FILE_STORAGE_MODE=cloud
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
COS_BUCKET=letmedoit-1308200923
COS_DOMAIN=https://letmedoit-1308200923.cos.ap-guangzhou.myqcloud.com/

# ===== 微信小程序（必填，否则无法登录）=====
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
# 内容安全：图片异步检测结果靠消息推送回传，Token 必须与
# 微信后台「开发管理 - 消息推送」里填的 Token 完全一致，否则验签必失败（推送收不到）
WX_PUSH_TOKEN=

# ===== 接口文档 Basic 认证（可选，knife4j 默认关闭）=====
KNIFE4J_USERNAME=
KNIFE4J_PASSWORD=
