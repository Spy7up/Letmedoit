.launch {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-left: 48rpx;
  padding-right: 48rpx;
  background: linear-gradient(180deg, #fff3ee 0%, #f7f4f1 46%, #f7f4f1 100%);
}

.launch-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 80rpx;
}

.brand-mark {
  width: 168rpx;
  height: 168rpx;
  border-radius: 44rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 20rpx 48rpx rgba(238, 78, 40, 0.26);
}

.brand {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  display: flex;
  align-items: flex-end;
}

.brand-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-left: 10rpx;
  margin-bottom: 14rpx;
}

.slogan {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--ink2);
  line-height: 1.7;
}

.launch-card {
  margin-top: 64rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(60, 40, 20, 0.06);
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.lc-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.lc-emoji {
  font-size: 32rpx;
}

.lc-text {
  font-size: 26rpx;
  color: var(--ink2);
}

.launch-foot {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.launch-tip {
  font-size: 21rpx;
  color: var(--ink3);
  text-align: center;
  line-height: 1.6;
}

/* ---------------- 协议勾选 ---------------- */

.agree {
  display: flex;
  align-items: flex-start;
  margin-bottom: 22rpx;
  padding: 0 6rpx;
}

.agree-box {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  margin-right: 12rpx;
  border: 2rpx solid #C9BEB4;
  border-radius: 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
}

.agree-box-on {
  background: #D64C28;
  border-color: #D64C28;
}

.agree-tick {
  width: 22rpx;
  height: 22rpx;
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8C8179;
}

.agree-plain {
  color: #8C8179;
}

.agree-link {
  color: #D64C28;
}

/* 未勾选时按钮压暗，但保留可点（点了给提示，比直接禁用更清楚） */
.btn-locked {
  opacity: 0.55;
}
