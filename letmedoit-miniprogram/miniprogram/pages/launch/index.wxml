<view class="launch" style="padding-top:{{statusBarHeight}}px">
  <view class="launch-main">
    <image class="brand-mark" src="/images/logo.png" mode="aspectFill" />
    <view class="brand">让我做<view class="brand-dot"></view></view>
    <text class="slogan">别人让你做的小事，说一遍就够。</text>

    <view class="launch-card">
      <view class="lc-row">
        <text class="lc-emoji">👵</text>
        <text class="lc-text">妈妈说：阳台衣服晾一下</text>
      </view>
      <view class="lc-row">
        <text class="lc-emoji">📌</text>
        <text class="lc-text">变成一条任务，到点提醒你</text>
      </view>
      <view class="lc-row">
        <text class="lc-emoji">✅</text>
        <text class="lc-text">做完点一下，妈妈立刻知道</text>
      </view>
    </view>
  </view>

  <view class="launch-foot">
    <!-- 协议勾选：不勾不给登，后端同样会拦一道 -->
    <view class="agree" bindtap="toggleAgree">
      <view class="agree-box {{agreed ? 'agree-box-on' : ''}}">
        <image wx:if="{{agreed}}" class="agree-tick" src="/images/icons/check-white.png" />
      </view>
      <view class="agree-text">
        <text class="agree-plain">我已阅读并同意</text>
        <text class="agree-link" catchtap="goAgreement" data-type="user">《用户协议》</text>
        <text class="agree-plain">和</text>
        <text class="agree-link" catchtap="goAgreement" data-type="privacy">《隐私政策》</text>
      </view>
    </view>

    <view class="btn btn-primary btn-lg {{agreed ? '' : 'btn-locked'}}" bindtap="onTapLogin">
      {{loading ? '正在登录…' : '微信一键登录'}}
    </view>
    <text class="launch-tip">{{tip || '登录后可以给帮手派活，也能收到别人的委托'}}</text>
  </view>
</view>
