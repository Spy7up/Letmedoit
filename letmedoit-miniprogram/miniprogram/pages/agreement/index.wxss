/* 协议阅读页：以可读性为第一优先，正文行长控制在手机屏 30 字左右 */
.doc {
  min-height: 100vh;
  padding: 32rpx 36rpx 0;
  box-sizing: border-box;
  background: #F7F4F1;
}

.doc-head {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #EAE3DC;
}

.doc-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #2E2A27;
  letter-spacing: 0.5rpx;
}

.doc-meta {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}

.doc-meta-item {
  font-size: 22rpx;
  color: #A69C93;
  margin-right: 24rpx;
}

/* ---------------- 正文 ---------------- */

.h1 {
  display: block;
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #2E2A27;
}

.h2 {
  display: block;
  margin-top: 44rpx;
  padding-left: 18rpx;
  border-left: 6rpx solid #D64C28;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #2E2A27;
}

.h3 {
  display: block;
  margin-top: 28rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: #3D3630;
}

.p {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.85;
  color: #4A423C;
  word-break: break-word;
}

.gap {
  height: 12rpx;
}

/* ---------------- 表格 ---------------- */

.tbl {
  margin-top: 18rpx;
  width: 100%;
  background: #FFFFFF;
  border: 1rpx solid #EAE3DC;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.tbl-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid #F2ECE6;
}

.tbl-row:last-child {
  border-bottom: none;
}

.tbl-cell {
  flex: 1 0 200rpx;
  padding: 16rpx 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4A423C;
  box-sizing: border-box;
  word-break: break-word;
}

.tbl-th {
  background: #FAF6F2;
  font-weight: 600;
  color: #2E2A27;
}

/* ---------------- 状态 ---------------- */

.doc-loading,
.doc-error {
  padding: 160rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.doc-muted {
  font-size: 28rpx;
  color: #A69C93;
}

.doc-err {
  font-size: 28rpx;
  color: #A69C93;
  text-align: center;
}

.doc-retry {
  margin-top: 32rpx;
}

.doc-foot {
  height: 80rpx;
}
